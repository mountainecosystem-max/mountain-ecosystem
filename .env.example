# Supabase Production Configuration Template
# Replace with your project details from https://app.supabase.com -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Data Mode
# 'production' = live database only (shows clean empty states when no listings are published)
# 'preview'    = temporary development preview data for demonstration/design review
VITE_DATA_MODE=production
